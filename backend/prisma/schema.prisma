generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Verdict {
  APPROVE
  REVIEW
  REJECT
}

model Scan {
  id                String    @id @default(uuid())
  documentType      String
  extractedData     Json
  validationResults Json
  tamperingFlags    Json
  faceScore         Float
  riskScore         Float
  verdict           Verdict
  needsReview       Boolean   @default(false)
  reviewedBy        String?
  reviewedAt        DateTime?
  evidenceImageUrl  String?
  createdAt         DateTime  @default(now())
}

model Blacklist {
  id             String   @id @default(uuid())
  documentNumber String   @unique
  documentType   String?
  reason         String
  addedBy        String?
  createdAt      DateTime @default(now())
}

model AuditEvent {
  id        String   @id @default(uuid())
  action    String
  actor     String?
  resource  String
  result    String
  detail    Json?
  createdAt DateTime @default(now())
}